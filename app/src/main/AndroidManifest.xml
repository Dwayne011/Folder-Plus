<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on Android 11+ to list other launchable apps without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".FolderPlusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FolderPlus"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The folder popup shown over the home screen when a widget is tapped. -->
        <activity
            android:name=".ui.open.FolderOpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.folderplus.popup"
            android:theme="@style/Theme.FolderPlus.Popup" />

        <!-- Invisible trampoline used by widget quick-launch icons so usage is recorded. -->
        <activity
            android:name=".launch.AppLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="com.folderplus.popup"
            android:theme="@style/Theme.FolderPlus.Invisible" />

        <activity
            android:name=".widget.FolderWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Three providers so the launcher's widget picker offers three default sizes.
             Every one of them is freely resizable afterwards. -->
        <receiver
            android:name=".widget.FolderWidgetProvider1x1"
            android:exported="true"
            android:label="@string/widget_label_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_1x1" />
        </receiver>
        <receiver
            android:name=".widget.FolderWidgetProvider2x2"
            android:exported="true"
            android:label="@string/widget_label_2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_2x2" />
        </receiver>
        <receiver
            android:name=".widget.FolderWidgetProvider4x1"
            android:exported="true"
            android:label="@string/widget_label_4x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_4x1" />
        </receiver>

        <receiver
            android:name=".widget.WidgetTapReceiver"
            android:exported="false" />
        <receiver
            android:name=".widget.WidgetPinReceiver"
            android:exported="false" />
    </application>
</manifest>
