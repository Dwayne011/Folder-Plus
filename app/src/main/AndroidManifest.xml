<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on Android 11+ to list other launchable apps without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Agenda widget reads upcoming calendar events. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:name=".WidgetsPlusApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WidgetsPlus"
        tools:targetApi="34">

        <!-- No launcher icon: everything is set up by dropping a widget and long-pressing it
             for its settings. This screen is the folder editor those settings open. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- The folder popup shown over the home screen when a widget is tapped. -->
        <activity
            android:name=".ui.open.FolderOpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.widgetsplus.popup"
            android:theme="@style/Theme.WidgetsPlus.Popup" />

        <!-- Invisible activity that tells a single tap from a double tap on a widget. -->
        <activity
            android:name=".widget.WidgetTapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.widgetsplus.popup"
            android:theme="@style/Theme.WidgetsPlus.Invisible" />

        <!-- Invisible trampoline used by widget quick-launch icons so usage is recorded. -->
        <activity
            android:name=".launch.AppLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="com.widgetsplus.popup"
            android:theme="@style/Theme.WidgetsPlus.Invisible" />

        <activity
            android:name=".widget.HostedWidgetPickerActivity"
            android:exported="false"
            android:label="@string/choose_widget" />

        <activity
            android:name=".widget.FolderWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Three providers so the launcher's widget picker offers three default sizes.
             Every one of them is freely resizable afterwards. -->
        <receiver
            android:name=".widget.FolderWidgetProvider1x1"
            android:exported="true"
            android:label="@string/widget_label_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_1x1" />
        </receiver>
        <receiver
            android:name=".widget.FolderWidgetProvider2x2"
            android:exported="true"
            android:label="@string/widget_label_2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_2x2" />
        </receiver>
        <receiver
            android:name=".widget.FolderWidgetProvider4x1"
            android:exported="true"
            android:label="@string/widget_label_4x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_4x1" />
        </receiver>

        <receiver
            android:name=".widget.WidgetPinReceiver"
            android:exported="false" />

        <!-- Calendar & Agenda widget -->
        <receiver
            android:name=".agenda.AgendaWidgetProvider"
            android:exported="true"
            android:label="@string/agenda_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data android:scheme="content" android:host="com.android.calendar" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda" />
        </receiver>
        <service
            android:name=".agenda.AgendaWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <activity
            android:name=".agenda.AgendaTapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="com.widgetsplus.popup"
            android:theme="@style/Theme.WidgetsPlus.Invisible" />
        <activity
            android:name=".agenda.AgendaDayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.widgetsplus.popup"
            android:theme="@style/Theme.WidgetsPlus.Popup" />
        <activity
            android:name=".agenda.AgendaConfigActivity"
            android:exported="true"
            android:label="@string/agenda_calendars">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".agenda.AgendaSetupActivity"
            android:exported="false"
            android:label="@string/agenda_setup_title" />
    </application>
</manifest>
