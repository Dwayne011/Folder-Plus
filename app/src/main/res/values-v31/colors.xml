<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material You: follow the system accent on Android 12+. -->
    <color name="widget_background">@android:color/system_neutral1_10</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_glyph">@android:color/system_accent1_600</color>
    <color name="ic_launcher_background">@android:color/system_accent1_600</color>
    <color name="widget_folder_disc">@android:color/system_neutral1_800</color>
    <!-- Agenda widget: tonal palette tones from the wallpaper seed -->
    <color name="agenda_plate">@android:color/system_neutral1_800</color>
    <!-- Solid plate: the card stack needs opaque surfaces (cards behind would show through),
         so the plate and every card backing use this one colour. -->
    <color name="agenda_plate_solid">@android:color/system_neutral1_900</color>
    <color name="agenda_card">@android:color/system_accent2_50</color>
    <color name="agenda_badge">@android:color/system_accent1_200</color>
    <color name="agenda_group">@android:color/system_accent2_200</color>
    <color name="agenda_on_card">@android:color/system_accent1_900</color>
    <color name="agenda_on_card_var">@android:color/system_neutral2_700</color>
    <color name="agenda_on_plate">@android:color/system_neutral1_100</color>
    <color name="agenda_on_plate_var">@android:color/system_neutral2_200</color>
    <color name="agenda_accent">@android:color/system_accent1_200</color>
</resources>
