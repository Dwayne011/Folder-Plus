<resources>
    <!-- How far the agenda card stack's box extends beyond the clipping frame on every side.
         StackView wraps each card in a frame with 4dp padding, so -4dp makes the front card
         exactly fill the frame. -->
    <dimen name="agenda_stack_overhang">-4dp</dimen>
</resources>
