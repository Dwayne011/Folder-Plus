<?xml version="1.0" encoding="utf-8"?>
<!-- One stack card = one day, built to the approved mockup's measured values: 104dp date card
     (radius 16, 2dp ring on today; month pill on top, weekday and date in the middle, Today pill
     at the bottom), 12dp gap, events group (radius 22, padding 6) with 44dp rows.
     Text sizes are in dp, like the mockup's px: in sp they grow with the phone's font-size
     setting and three lines no longer fit a 44dp row. Line boxes are Google Sans's own
     (1.25em); the 56dp numeral gets -1dp margins so its 70dp line box plus the 4dp gaps
     matches the mockup's 60dp line. On Android 12+ the service sets this card's height to the
     frame's height; the oversized minWidth/minHeight make it fill the space StackView offers
     otherwise (StackView measures cards AT_MOST; LinearLayout clamps the minimum to that). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:minWidth="4000dp"
    android:minHeight="4000dp"
    android:orientation="horizontal"
    tools:ignore="UnusedAttribute,SpUsage">

    <FrameLayout
        android:id="@+id/day_date"
        android:layout_width="104dp"
        android:layout_height="match_parent">
        <!-- Ring = a plate behind the face, which is inset 2dp (stroke-only shapes fill when tinted via RemoteViews). -->
        <ImageView android:id="@+id/day_today_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
        <ImageView android:id="@+id/day_date_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card_inner" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="6dp" android:paddingTop="10dp" android:paddingEnd="6dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/day_dow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="500" android:letterSpacing="0.05" android:textAllCaps="true" android:textSize="16dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            <TextView android:id="@+id/day_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-1dp" android:layout_marginBottom="-5dp" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:letterSpacing="-0.02" android:textAllCaps="true" android:textSize="56dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
        </LinearLayout>
        <!-- month pill (top): opens the "Next 30 days" sheet -->
        <FrameLayout android:id="@+id/day_month_pill" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp">
            <ImageView android:id="@+id/day_month_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
            <TextView android:id="@+id/day_month_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:textAllCaps="true" android:textSize="10.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
        </FrameLayout>
        <!-- Today pill (bottom, every day but today): shows today's card again -->
        <FrameLayout android:id="@+id/day_today_pill" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="10dp" android:visibility="gone">
            <ImageView android:id="@+id/day_today_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
            <TextView android:id="@+id/day_today_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/agenda_today" android:textSize="10.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1">
        <ImageView android:id="@+id/day_group_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_group" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">

            <!-- event row: 44dp, padding 4/8, 32dp badge (radius 10, 18dp icon), 8dp gap, text 10/12.5/11 -->
            <FrameLayout android:id="@+id/ev1" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="0dp" android:visibility="gone">
                <ImageView android:id="@+id/ev1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                        <ImageView android:id="@+id/ev1_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/ev1_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/ev1_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        <TextView android:id="@+id/ev1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                        <TextView android:id="@+id/ev1_loc" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <!-- event row: 44dp, padding 4/8, 32dp badge (radius 10, 18dp icon), 8dp gap, text 10/12.5/11 -->
            <FrameLayout android:id="@+id/ev2" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:visibility="gone">
                <ImageView android:id="@+id/ev2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                        <ImageView android:id="@+id/ev2_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/ev2_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/ev2_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        <TextView android:id="@+id/ev2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                        <TextView android:id="@+id/ev2_loc" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <!-- event row: 44dp, padding 4/8, 32dp badge (radius 10, 18dp icon), 8dp gap, text 10/12.5/11 -->
            <FrameLayout android:id="@+id/ev3" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:visibility="gone">
                <ImageView android:id="@+id/ev3_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                        <ImageView android:id="@+id/ev3_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/ev3_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/ev3_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        <TextView android:id="@+id/ev3_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                        <TextView android:id="@+id/ev3_loc" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <!-- event row: 44dp, padding 4/8, 32dp badge (radius 10, 18dp icon), 8dp gap, text 10/12.5/11 -->
            <FrameLayout android:id="@+id/ev4" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:visibility="gone">
                <ImageView android:id="@+id/ev4_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                        <ImageView android:id="@+id/ev4_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/ev4_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/ev4_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        <TextView android:id="@+id/ev4_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                        <TextView android:id="@+id/ev4_loc" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <!-- event row: 44dp, padding 4/8, 32dp badge (radius 10, 18dp icon), 8dp gap, text 10/12.5/11 -->
            <FrameLayout android:id="@+id/ev5" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:visibility="gone">
                <ImageView android:id="@+id/ev5_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                        <ImageView android:id="@+id/ev5_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/ev5_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/ev5_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        <TextView android:id="@+id/ev5_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                        <TextView android:id="@+id/ev5_loc" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- "+N more": 18dp pill, 2dp in, 6dp below the last row, 10.5sp medium -->
            <FrameLayout android:id="@+id/day_more_wrap" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_marginTop="6dp" android:visibility="gone">
                <ImageView android:id="@+id/day_more_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                <TextView android:id="@+id/day_more" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="10.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            </FrameLayout>

            <FrameLayout android:id="@+id/day_free" android:layout_width="match_parent" android:layout_height="44dp" android:visibility="gone">
                <ImageView android:id="@+id/day_free_outline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_free_outline" />
                <TextView android:id="@+id/day_free_text" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:text="@string/agenda_nothing_planned" android:textSize="11dp" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
