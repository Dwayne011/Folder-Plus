<?xml version="1.0" encoding="utf-8"?>
<!-- One stack card = one day, for the smaller calendar widget sizes (approved mockup), Android 12+.
     From 3 columns: a 60dp date card (radius 14, ring on today, month pill, weekday and date,
     "Today" pill) beside the events. At 2 columns: the date as one 26dp line above the events
     ("THU 5 NOV", or "MON 9" with a "Today" pill). Events: 38dp two-line rows (time, title) and
     22dp one-line all-day strips in a group with 5dp padding and gaps, "+N more" below; one row
     high, every event is one 22dp line and "+N" sits at the end of the last line.
     The service sets the card's height, which rows show and the sizes for the text size; the
     oversized minWidth/minHeight make it fill the space StackView offers (see widget_agenda_day). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:minWidth="4000dp"
    android:minHeight="4000dp"
    android:orientation="vertical"
    tools:ignore="UnusedAttribute,SpUsage">

    <!-- 2 columns: the date line (tap: next 30 days) with "Today" on other days -->
    <FrameLayout android:id="@+id/day_head" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="6dp" android:visibility="gone">
        <ImageView android:id="@+id/day_head_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
        <ImageView android:id="@+id/day_head_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingEnd="5dp">
            <TextView android:id="@+id/day_head_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:letterSpacing="0.02" android:textAllCaps="true" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            <TextView android:id="@+id/day_head_month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="google-sans" android:textFontWeight="500" android:letterSpacing="0.02" android:textAllCaps="true" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            <FrameLayout android:id="@+id/day_head_today" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="4dp" android:visibility="gone">
                <ImageView android:id="@+id/day_head_today_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                <TextView android:id="@+id/day_head_today_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="@string/agenda_today_short" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">

        <!-- From 3 columns: the narrow date card -->
        <FrameLayout android:id="@+id/day_date" android:layout_width="60dp" android:layout_height="match_parent">
            <ImageView android:id="@+id/day_today_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_date_c" />
            <ImageView android:id="@+id/day_date_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_date_c_inner" />
            <LinearLayout android:id="@+id/day_date_mid" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="3dp" android:paddingTop="26dp" android:paddingEnd="3dp" android:paddingBottom="26dp">
                <TextView android:id="@+id/day_dow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="500" android:letterSpacing="0.05" android:textAllCaps="true" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <TextView android:id="@+id/day_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="-3dp" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:letterSpacing="-0.02" android:textSize="34dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            </LinearLayout>
            <!-- month pill (tap: next 30 days) -->
            <FrameLayout android:id="@+id/day_month_tap" android:layout_width="match_parent" android:layout_height="32dp" android:layout_gravity="top">
                <FrameLayout android:id="@+id/day_month_pill" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="8dp">
                    <ImageView android:id="@+id/day_month_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                    <TextView android:id="@+id/day_month_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textAllCaps="true" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                </FrameLayout>
            </FrameLayout>
            <!-- "Today" (other days) -->
            <FrameLayout android:id="@+id/day_today_tap" android:layout_width="match_parent" android:layout_height="32dp" android:layout_gravity="bottom" android:visibility="gone">
                <FrameLayout android:id="@+id/day_today_pill" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:id="@+id/day_today_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                    <TextView android:id="@+id/day_today_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="@string/agenda_today_short" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <FrameLayout android:id="@+id/day_group" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1">
            <ImageView android:id="@+id/day_group_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_group_c" />
            <LinearLayout android:id="@+id/day_group_list" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="5dp">

            <FrameLayout android:id="@+id/ev1" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="0dp" android:visibility="gone">
