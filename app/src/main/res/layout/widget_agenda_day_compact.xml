                        <TextView android:id="@+id/ev3_more_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/ev4" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ev4_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card_c" />
                <!-- timed event on two lines: dot and time, then the title -->
                <LinearLayout android:id="@+id/ev4_two" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/ev4_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                        <TextView android:id="@+id/ev4_when" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/ev4_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                </LinearLayout>
                <!-- one line: an all-day strip, or (one row high) a timed event; "+N" at the end of the last line -->
                <LinearLayout android:id="@+id/ev4_one" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingEnd="9dp" android:visibility="gone">
                    <ImageView android:id="@+id/ev4_odot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                    <TextView android:id="@+id/ev4_otime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:visibility="gone" />
                    <TextView android:id="@+id/ev4_otitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="11.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                    <FrameLayout android:id="@+id/ev4_more" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="6dp" android:visibility="gone">
                        <ImageView android:id="@+id/ev4_more_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                        <TextView android:id="@+id/ev4_more_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/ev5" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ev5_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card_c" />
                <!-- timed event on two lines: dot and time, then the title -->
                <LinearLayout android:id="@+id/ev5_two" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/ev5_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                        <TextView android:id="@+id/ev5_when" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/ev5_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                </LinearLayout>
                <!-- one line: an all-day strip, or (one row high) a timed event; "+N" at the end of the last line -->
                <LinearLayout android:id="@+id/ev5_one" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingEnd="9dp" android:visibility="gone">
                    <ImageView android:id="@+id/ev5_odot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                    <TextView android:id="@+id/ev5_otime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:visibility="gone" />
                    <TextView android:id="@+id/ev5_otitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="11.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                    <FrameLayout android:id="@+id/ev5_more" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="6dp" android:visibility="gone">
                        <ImageView android:id="@+id/ev5_more_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                        <TextView android:id="@+id/ev5_more_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

                <!-- "+N more": 16dp pill, 2dp in, 5dp below the last row -->
                <FrameLayout android:id="@+id/day_more_wrap" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="2dp" android:layout_marginTop="5dp" android:visibility="gone">
                    <ImageView android:id="@+id/day_more_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                    <TextView android:id="@+id/day_more" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                </FrameLayout>

                <FrameLayout android:id="@+id/day_free" android:layout_width="match_parent" android:layout_height="38dp" android:visibility="gone">
                    <ImageView android:id="@+id/day_free_outline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_free_outline" />
                    <TextView android:id="@+id/day_free_text" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:text="@string/agenda_nothing_planned" android:textSize="11dp" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
