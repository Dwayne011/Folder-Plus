                <!-- timed event on two lines: dot and time, then the title -->
                <LinearLayout android:id="@+id/ev1_two" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/ev1_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                        <TextView android:id="@+id/ev1_when" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/ev1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                </LinearLayout>
                <!-- one line: an all-day strip, or (one row high) a timed event; "+N" at the end of the last line -->
                <LinearLayout android:id="@+id/ev1_one" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingEnd="9dp" android:visibility="gone">
                    <ImageView android:id="@+id/ev1_odot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                    <TextView android:id="@+id/ev1_otime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:visibility="gone" />
                    <TextView android:id="@+id/ev1_otitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="11.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                    <FrameLayout android:id="@+id/ev1_more" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="6dp" android:visibility="gone">
