                        <TextView android:id="@+id/ev1_more_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/ev2" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ev2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card_c" />
                <!-- timed event on two lines: dot and time, then the title -->
                <LinearLayout android:id="@+id/ev2_two" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/ev2_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                        <TextView android:id="@+id/ev2_when" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/ev2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                </LinearLayout>
                <!-- one line: an all-day strip, or (one row high) a timed event; "+N" at the end of the last line -->
                <LinearLayout android:id="@+id/ev2_one" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingEnd="9dp" android:visibility="gone">
                    <ImageView android:id="@+id/ev2_odot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                    <TextView android:id="@+id/ev2_otime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:visibility="gone" />
                    <TextView android:id="@+id/ev2_otitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="11.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                    <FrameLayout android:id="@+id/ev2_more" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginStart="6dp" android:visibility="gone">
                        <ImageView android:id="@+id/ev2_more_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" />
                        <TextView android:id="@+id/ev2_more_text" android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textSize="9.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/ev3" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:visibility="gone">
                <ImageView android:id="@+id/ev3_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card_c" />
                <!-- timed event on two lines: dot and time, then the title -->
                <LinearLayout android:id="@+id/ev3_two" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/ev3_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                        <TextView android:id="@+id/ev3_when" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/ev3_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                </LinearLayout>
                <!-- one line: an all-day strip, or (one row high) a timed event; "+N" at the end of the last line -->
                <LinearLayout android:id="@+id/ev3_one" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingEnd="9dp" android:visibility="gone">
                    <ImageView android:id="@+id/ev3_odot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_dot" android:visibility="gone" />
                    <TextView android:id="@+id/ev3_otime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:visibility="gone" />
                    <TextView android:id="@+id/ev3_otitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="11.5dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
