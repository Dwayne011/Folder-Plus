<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted plate holding a card stack of days.
     StackView lays the front card out in the bottom-left 90% of its own bounds and fans the
     back cards up and to the right. To show exactly the front card, the stack is made 10/9 of
     the clipping frame and aligned to its bottom-left: two LinearLayouts with weightSum 9 give
     a weight-10 child 10/9 of the parent, and gravity=bottom pushes the overflow above the
     frame. Everything outside the frame's padding is clipped. This is proportional, so it holds
     whatever size the launcher really gives the widget.
     StackView also wraps each card in a frame with 4dp padding, so the box the stack is sized
     from is the clipping frame grown by at least 4dp on every side (agenda_stack_overhang).
     The overhang is set per side on purpose: Android ignores a negative all-sides layout_margin.
     On Android 12+ the frame clips to a rounded outline and the overhang is a little larger, so
     the front card overflows the frame slightly and no sliver of the next card can show. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/agenda_plate" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_plate" />
    <ImageView android:id="@+id/agenda_hairline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_hairline" />

    <FrameLayout
        android:id="@+id/agenda_clip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/agenda_stack_column"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/agenda_frame_outline"
            android:clipChildren="true"
            android:clipToOutline="true"
            tools:targetApi="s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/agenda_stack_overhang"
                android:layout_marginTop="@dimen/agenda_stack_overhang"
                android:layout_marginEnd="@dimen/agenda_stack_overhang"
                android:layout_marginBottom="@dimen/agenda_stack_overhang"
                android:gravity="bottom"
                android:orientation="vertical"
                android:weightSum="9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="10"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal"
                    android:weightSum="9">

                    <StackView
                        android:id="@+id/agenda_stack"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="10"
                        android:loopViews="false" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/agenda_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
