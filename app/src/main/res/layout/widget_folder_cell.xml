<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the mosaic: its own launcher icon, 34dp, centred in an equal share of the row. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">
    <ImageView android:id="@+id/cell_icon" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:scaleType="fitCenter" />
</FrameLayout>
