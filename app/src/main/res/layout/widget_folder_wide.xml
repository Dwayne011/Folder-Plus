<?xml version="1.0" encoding="utf-8"?>
<!-- Nx1 wide: icon + name on the left, quick-launch strip on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/Widget.WidgetsPlus.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_main"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="72dp"
                android:textColor="@color/widget_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <include layout="@layout/widget_quick_strip" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_badge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_badge_background"
        android:contentDescription="@string/widget_open_folder"
        android:padding="2dp"
        android:src="@drawable/ic_expand"
        android:visibility="gone" />
</FrameLayout>
