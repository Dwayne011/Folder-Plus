<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview of the Agenda widget: one static day card on the frosted plate.
     Plain ImageViews (RemoteViews cannot use AppCompat), so android:tint is the right attribute here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.85" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_plate" android:tint="@color/agenda_plate" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="match_parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_card" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.05" android:text="@string/preview_dow" android:textAllCaps="true" android:textColor="@color/agenda_on_card_var" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:letterSpacing="-0.02" android:text="@string/preview_day" android:textColor="@color/agenda_on_card" android:textSize="56sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.05" android:text="@string/preview_mon" android:textAllCaps="true" android:textColor="@color/agenda_on_card_var" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_group" android:tint="@color/agenda_group" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">

                <FrameLayout android:layout_width="match_parent" android:layout_height="44dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_card" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" android:tint="@color/agenda_badge" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_agenda_videocam" android:tint="@color/agenda_on_card" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:text="@string/preview_when_1" android:textColor="@color/agenda_on_card_var" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="@string/preview_title_1" android:textColor="@color/agenda_on_card" android:textSize="12.5sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="@string/preview_loc_1" android:textColor="@color/agenda_on_card_var" android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_card" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" android:tint="@color/agenda_badge" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_agenda_restaurant" android:tint="@color/agenda_on_card" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:text="@string/preview_when_2" android:textColor="@color/agenda_on_card_var" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="@string/preview_title_2" android:textColor="@color/agenda_on_card" android:textSize="12.5sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_card" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" android:tint="@color/agenda_badge" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_agenda_fitness" android:tint="@color/agenda_on_card" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:text="@string/preview_when_3" android:textColor="@color/agenda_on_card_var" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="@string/preview_title_3" android:textColor="@color/agenda_on_card" android:textSize="12.5sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_marginTop="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" android:tint="@color/agenda_card" />
                    <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/preview_more" android:textColor="@color/agenda_on_card_var" android:textSize="10.5sp" android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
