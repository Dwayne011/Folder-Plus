<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview of the Agenda widget: one static day card on the plate, same
     measurements as the live card (widget_agenda_day). Plain framework views, so android:tint
     is the right attribute here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint,UnusedAttribute,SpUsage">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:alpha="0.58" android:src="@drawable/agenda_shape_plate" android:tint="@color/agenda_plate" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="match_parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_accent" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card_inner" android:tint="@color/agenda_card" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="6dp" android:paddingTop="10dp" android:paddingEnd="6dp" android:paddingBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="500" android:letterSpacing="0.05" android:textAllCaps="true" android:textSize="16dp" android:text="@string/preview_dow" android:textColor="@color/agenda_on_card_var" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:layout_marginTop="-1dp" android:layout_marginBottom="-5dp" android:textFontWeight="700" android:textStyle="bold" android:letterSpacing="-0.02" android:textAllCaps="true" android:textSize="56dp" android:text="@string/preview_day" android:textColor="@color/agenda_on_card" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            </LinearLayout>
            <FrameLayout android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" android:tint="@color/agenda_badge" />
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:textAllCaps="true" android:textSize="10.5dp" android:text="@string/preview_mon" android:textColor="@color/agenda_on_card" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_group" android:tint="@color/agenda_group" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">

                <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="0dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_card" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" android:tint="@color/agenda_badge" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_agenda_videocam" android:tint="@color/agenda_on_card" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:text="@string/preview_when_1" android:textColor="@color/agenda_on_card_var" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:ellipsize="end" android:text="@string/preview_title_1" android:textColor="@color/agenda_on_card" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="11dp" android:maxLines="1" android:ellipsize="end" android:text="@string/preview_loc_1" android:textColor="@color/agenda_on_card_var" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_card" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" android:tint="@color/agenda_badge" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_agenda_restaurant" android:tint="@color/agenda_on_card" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:text="@string/preview_when_2" android:textColor="@color/agenda_on_card_var" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:ellipsize="end" android:text="@string/preview_title_2" android:textColor="@color/agenda_on_card" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" android:tint="@color/agenda_card" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" android:tint="@color/agenda_badge" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_agenda_fitness" android:tint="@color/agenda_on_card" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="10dp" android:maxLines="1" android:text="@string/preview_when_3" android:textColor="@color/agenda_on_card_var" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:textSize="12.5dp" android:maxLines="1" android:ellipsize="end" android:text="@string/preview_title_3" android:textColor="@color/agenda_on_card" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="2dp" android:layout_marginTop="6dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_chip" android:tint="@color/agenda_card" />
                    <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="10.5dp" android:text="@string/preview_more" android:textColor="@color/agenda_on_card_var" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
