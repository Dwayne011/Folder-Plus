<?xml version="1.0" encoding="utf-8"?>
<!-- Connected devices widget, Agenda style (approved mockup): the agenda's see-through plate
     with a 28dp header band, around the agenda's events-panel colour inset 8dp on the sides and
     bottom. The panel holds up to three equal columns (s1..s3): three or two devices, one
     device beside this phone, or this phone alone (centred) when nothing is connected.
     A column shows either a drawing with its level and a bar, or (for device types without a
     drawing) a ring with the device's icon and its level. Drawings, rings and bars are bitmaps
     drawn by the provider. A ring column keeps its bar's space (invisible) so every name sits
     at the same height. Text is in dp, like the mockup's px, so it doesn't grow with the
     phone's font-size setting. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dev_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="SpUsage,UnusedAttribute,ContentDescription">

    <ImageView android:id="@+id/dev_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_plate" />
    <ImageView android:id="@+id/dev_hairline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_hairline" />
    <TextView android:id="@+id/dev_head" android:layout_width="match_parent" android:layout_height="28dp" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:gravity="center" android:letterSpacing="0.1" android:textAllCaps="true" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp">

        <ImageView android:id="@+id/dev_well" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_group" />

        <LinearLayout
            android:id="@+id/dev_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout android:id="@+id/s1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                    <ImageView android:id="@+id/s1_draw" android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="center" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/s1_ring" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" />
                    <ImageView android:id="@+id/s1_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" />
                </FrameLayout>
                <TextView android:id="@+id/s1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="google-sans" android:textFontWeight="500" android:textSize="13dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <TextView android:id="@+id/s1_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <ImageView android:id="@+id/s1_bar" android:layout_width="72dp" android:layout_height="5dp" android:layout_marginTop="5dp" android:scaleType="fitXY" />
            </LinearLayout>

            <LinearLayout android:id="@+id/s2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                    <ImageView android:id="@+id/s2_draw" android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="center" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/s2_ring" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" />
                    <ImageView android:id="@+id/s2_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" />
                </FrameLayout>
                <TextView android:id="@+id/s2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="google-sans" android:textFontWeight="500" android:textSize="13dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <TextView android:id="@+id/s2_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <ImageView android:id="@+id/s2_bar" android:layout_width="72dp" android:layout_height="5dp" android:layout_marginTop="5dp" android:scaleType="fitXY" />
            </LinearLayout>

            <LinearLayout android:id="@+id/s3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                    <ImageView android:id="@+id/s3_draw" android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="center" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/s3_ring" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" />
                    <ImageView android:id="@+id/s3_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" />
                </FrameLayout>
                <TextView android:id="@+id/s3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="google-sans" android:textFontWeight="500" android:textSize="13dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <TextView android:id="@+id/s3_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
                <ImageView android:id="@+id/s3_bar" android:layout_width="72dp" android:layout_height="5dp" android:layout_marginTop="5dp" android:scaleType="fitXY" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dev_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="google-sans-text"
            android:gravity="center"
            android:padding="16dp"
            android:textFontWeight="500"
            android:textSize="13dp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
