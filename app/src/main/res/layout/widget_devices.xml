<?xml version="1.0" encoding="utf-8"?>
<!-- Connected devices widget, built to the approved frosted mockup: a 28dp header band in a
     translucent primary-colour frame (34%), around a 6dp-inset well (62%). The well holds one of
     four arrangements, picked by how many connected devices report a battery level:
     n3 = three columns, n2 = two cards, n1 = the device beside this phone, n0 = this phone and
     shortcuts. Rings and bars are bitmaps drawn by the provider. Text is in dp, like the
     mockup's px, so it doesn't grow with the phone's font-size setting. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dev_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="SpUsage,UnusedAttribute,ContentDescription">

    <ImageView android:id="@+id/dev_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_frame" />
    <ImageView android:id="@+id/dev_hairline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_hairline" />
    <TextView android:id="@+id/dev_head" android:layout_width="match_parent" android:layout_height="28dp" android:fontFamily="google-sans-text" android:textFontWeight="700" android:textStyle="bold" android:gravity="center" android:letterSpacing="0.1" android:textAllCaps="true" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp">

        <ImageView android:id="@+id/dev_well" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_well" />
        <ImageView android:id="@+id/dev_well_line" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_well_line" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp">

        <LinearLayout android:id="@+id/n3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <LinearLayout android:id="@+id/sa" android:layout_width="112dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                    <ImageView android:id="@+id/sa_buds_main" android:layout_width="112dp" android:layout_height="48dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_buds_main" android:layout_gravity="center" />
                    <ImageView android:id="@+id/sa_buds_detail" android:layout_width="112dp" android:layout_height="48dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_buds_detail" android:layout_gravity="center" />
                    <ImageView android:id="@+id/sa_ring" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@null" android:scaleType="fitXY" android:layout_gravity="center" />
                    <ImageView android:id="@+id/sa_icon" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/ic_dev_bluetooth" android:layout_gravity="center" />
                    <TextView android:id="@+id/sa_pct_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_gravity="center" />
                </FrameLayout>
                <TextView android:id="@+id/sa_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="500" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="6dp" android:ellipsize="end" android:maxWidth="112dp" />
                <TextView android:id="@+id/sa_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="2dp" />
                <ImageView android:id="@+id/sa_bar" android:layout_width="72dp" android:layout_height="5dp" android:contentDescription="@null" android:scaleType="fitXY" android:layout_marginTop="4dp" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/sb" android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                    <ImageView android:id="@+id/sb_ring" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@null" android:scaleType="fitXY" android:layout_gravity="center" />
                    <ImageView android:id="@+id/sb_icon" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/ic_dev_bluetooth" android:layout_gravity="center" />
                    <TextView android:id="@+id/sb_pct_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_gravity="center" />
                </FrameLayout>
                <TextView android:id="@+id/sb_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="500" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="6dp" android:ellipsize="end" android:maxWidth="76dp" />
                <TextView android:id="@+id/sb_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="2dp" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/sc" android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                    <ImageView android:id="@+id/sc_ring" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@null" android:scaleType="fitXY" android:layout_gravity="center" />
                    <ImageView android:id="@+id/sc_icon" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/ic_dev_bluetooth" android:layout_gravity="center" />
                    <TextView android:id="@+id/sc_pct_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_gravity="center" />
                </FrameLayout>
                <TextView android:id="@+id/sc_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="500" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="6dp" android:ellipsize="end" android:maxWidth="76dp" />
                <TextView android:id="@+id/sc_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/n2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/c1" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1">
                <ImageView android:id="@+id/c1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                        <ImageView android:id="@+id/c1_glyph" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_circle" />
                        <ImageView android:id="@+id/c1_icon" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/ic_dev_bluetooth" android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/c1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                        <TextView android:id="@+id/c1_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="20dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="4dp" />
                        <ImageView android:id="@+id/c1_bar" android:layout_width="70dp" android:layout_height="5dp" android:contentDescription="@null" android:scaleType="fitXY" android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <View android:layout_width="12dp" android:layout_height="1dp" />
            <FrameLayout android:id="@+id/c2" android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1">
                <ImageView android:id="@+id/c2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                        <ImageView android:id="@+id/c2_glyph" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_circle" />
                        <ImageView android:id="@+id/c2_icon" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/ic_dev_bluetooth" android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/c2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                        <TextView android:id="@+id/c2_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="20dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="4dp" />
                        <ImageView android:id="@+id/c2_bar" android:layout_width="70dp" android:layout_height="5dp" android:contentDescription="@null" android:scaleType="fitXY" android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/n1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/n1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="500" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                        <ImageView android:id="@+id/g1_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
                        <TextView android:id="@+id/g1_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_gravity="center" />
                    </FrameLayout>
                    <TextView android:id="@+id/g1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="3dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                        <ImageView android:id="@+id/g2_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
                        <TextView android:id="@+id/g2_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="13dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_gravity="center" />
                    </FrameLayout>
                    <TextView android:id="@+id/g2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/n0" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
                    <ImageView android:id="@+id/n0_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
                    <TextView android:id="@+id/n0_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans" android:textFontWeight="700" android:textStyle="bold" android:textSize="15dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_gravity="center" />
                </FrameLayout>
                <TextView android:id="@+id/n0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="4dp" android:text="@string/devices_this_phone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/n0_shortcuts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <FrameLayout android:id="@+id/sc1" android:layout_width="match_parent" android:layout_height="40dp">
                    <ImageView android:id="@+id/sc1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_pill" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="14dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:id="@+id/sc1_glyph" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_circle" />
                            <ImageView android:id="@+id/sc1_icon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/ic_dev_bluetooth" android:layout_gravity="center" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/sc1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                            <TextView android:id="@+id/sc1_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="1dp" android:text="@string/devices_tap_to_connect" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout android:id="@+id/sc2" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp">
                    <ImageView android:id="@+id/sc2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_pill" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="14dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
                            <ImageView android:id="@+id/sc2_glyph" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/dev_shape_circle" />
                            <ImageView android:id="@+id/sc2_icon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/ic_dev_bluetooth" android:layout_gravity="center" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/sc2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="500" android:textSize="12dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:ellipsize="end" />
                            <TextView android:id="@+id/sc2_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textFontWeight="400" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginTop="1dp" android:text="@string/devices_tap_to_connect" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/dev_message" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="google-sans-text" android:textFontWeight="500" android:gravity="center" android:textSize="13dp" android:visibility="gone" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
