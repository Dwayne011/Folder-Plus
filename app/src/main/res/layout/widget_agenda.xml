<?xml version="1.0" encoding="utf-8"?>
<!-- The agenda widget shows the resting frame of the agenda design (pinned date card,
     first days of the feed) and opens the full interactive agenda popup on tap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/agenda_plate" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_plate" />
    <ImageView android:id="@+id/agenda_hairline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_hairline" />

    <LinearLayout
        android:id="@+id/agenda_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/date_card"
                android:layout_width="104dp"
                android:layout_height="138dp">
                <ImageView android:id="@+id/date_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <ImageView android:id="@+id/date_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_today_ring" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/date_dow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.05" android:textAllCaps="true" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/date_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:letterSpacing="-0.02" android:textSize="56sp" android:textStyle="bold" />
                    <TextView android:id="@+id/date_mon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.05" android:textAllCaps="true" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            
        <FrameLayout
            android:id="@+id/g1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:visibility="gone">
            <ImageView android:id="@+id/g1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_group" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="6dp">
                
            <FrameLayout
                android:id="@+id/g1_ev1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="0dp"
                android:visibility="gone">
                <ImageView android:id="@+id/g1_ev1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                        <ImageView android:id="@+id/g1_ev1_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/g1_ev1_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/g1_ev1_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/g1_ev1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
                
            <FrameLayout
                android:id="@+id/g1_ev2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">
                <ImageView android:id="@+id/g1_ev2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                        <ImageView android:id="@+id/g1_ev2_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/g1_ev2_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/g1_ev2_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/g1_ev2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
                <TextView android:id="@+id/g1_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="6dp" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                <FrameLayout android:id="@+id/g1_free" android:layout_width="match_parent" android:layout_height="56dp" android:visibility="gone">
                    <ImageView android:id="@+id/g1_free_outline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_free_outline" />
                    <TextView android:id="@+id/g1_free_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/agenda_nothing_planned" android:textSize="12sp" android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
            
        <FrameLayout
            android:id="@+id/g2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">
            <ImageView android:id="@+id/g2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_group" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="6dp">
                
            <FrameLayout
                android:id="@+id/g2_ev1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="0dp"
                android:visibility="gone">
                <ImageView android:id="@+id/g2_ev1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                        <ImageView android:id="@+id/g2_ev1_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/g2_ev1_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/g2_ev1_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/g2_ev1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
                
            <FrameLayout
                android:id="@+id/g2_ev2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">
                <ImageView android:id="@+id/g2_ev2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_card" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                        <ImageView android:id="@+id/g2_ev2_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_badge" />
                        <ImageView android:id="@+id/g2_ev2_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/g2_ev2_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/g2_ev2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
                <TextView android:id="@+id/g2_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="6dp" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                <FrameLayout android:id="@+id/g2_free" android:layout_width="match_parent" android:layout_height="56dp" android:visibility="gone">
                    <ImageView android:id="@+id/g2_free_outline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_free_outline" />
                    <TextView android:id="@+id/g2_free_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/agenda_nothing_planned" android:textSize="12sp" android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/agenda_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
