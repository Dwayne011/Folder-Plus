<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted plate holding a card stack of days. StackView lays the front card out in the
     bottom-left 90% of its bounds and fans the back cards up and to the right. The stack is
     therefore made 1/9 larger than the clipping frame on the top and end sides so that only
     the front card is visible. These margins are the pre-Android-12 approximation; on 12+ the
     provider sets them from the widget's actual size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/agenda_plate" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_shape_plate" />
    <ImageView android:id="@+id/agenda_hairline" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/agenda_hairline" />

    <FrameLayout
        android:id="@+id/agenda_clip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:padding="16dp">

        <StackView
            android:id="@+id/agenda_stack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-22dp"
            android:layout_marginEnd="-36dp"
            android:loopViews="false" />

        <TextView
            android:id="@+id/agenda_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
