<?xml version="1.0" encoding="utf-8"?>
<!-- The short form of widget_bud_line ("L72 R70 C40") for the 2×2 with three or four rows.
     Each level has a normal and a low-battery (15% or less) pair of views, so every colour
     comes from a colour resource and follows the phone's light or dark theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView android:id="@+id/bl_l_lab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:textColor="@color/agenda_on_card_var" android:text="@string/buds_left" />
    <TextView android:id="@+id/bl_l_lab_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:textColor="@color/dev_low" android:text="@string/buds_left" android:visibility="gone" />
    <TextView android:id="@+id/bl_l_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginStart="0.5dp" android:textColor="@color/agenda_on_card" android:textFontWeight="500" />
    <TextView android:id="@+id/bl_l_val_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginStart="0.5dp" android:textColor="@color/dev_low" android:textFontWeight="500" android:visibility="gone" />
    <FrameLayout android:id="@+id/bl_sep1" android:layout_width="5dp" android:layout_height="1dp" />
    <TextView android:id="@+id/bl_r_lab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:textColor="@color/agenda_on_card_var" android:text="@string/buds_right" />
    <TextView android:id="@+id/bl_r_lab_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:textColor="@color/dev_low" android:text="@string/buds_right" android:visibility="gone" />
    <TextView android:id="@+id/bl_r_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginStart="0.5dp" android:textColor="@color/agenda_on_card" android:textFontWeight="500" />
    <TextView android:id="@+id/bl_r_val_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginStart="0.5dp" android:textColor="@color/dev_low" android:textFontWeight="500" android:visibility="gone" />
    <FrameLayout android:id="@+id/bl_sep2" android:layout_width="5dp" android:layout_height="1dp" />
    <TextView android:id="@+id/bl_c_lab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:textColor="@color/agenda_on_card_var" android:text="@string/buds_case_short" />
    <TextView android:id="@+id/bl_c_lab_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:textColor="@color/dev_low" android:text="@string/buds_case_short" android:visibility="gone" />
    <TextView android:id="@+id/bl_c_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginStart="0.5dp" android:textColor="@color/agenda_on_card" android:textFontWeight="500" />
    <TextView android:id="@+id/bl_c_val_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="google-sans-text" android:textSize="10dp" android:maxLines="1" android:includeFontPadding="false" android:elegantTextHeight="false" android:fallbackLineSpacing="false" android:layout_marginStart="0.5dp" android:textColor="@color/dev_low" android:textFontWeight="500" android:visibility="gone" />
</LinearLayout>
